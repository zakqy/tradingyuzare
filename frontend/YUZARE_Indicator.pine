//@version=5
indicator("YUZARE [Zero Repaint]", shorttitle="YUZARE", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ==========================================
// 1. INPUT CONFIGURATION & PARAMETERS
// ==========================================
grp_engine = "YUZARE Engine Settings"
fast_len = input.int(9, "Fast EMA Length", group=grp_engine)
slow_len = input.int(21, "Slow EMA Length", group=grp_engine)
atr_len  = input.int(14, "ATR Volatility Length", group=grp_engine)
atr_mult = input.float(1.5, "ATR Multiplier for SL", step=0.1, group=grp_engine)

grp_pz = "01. Pending Zones Settings (Future Projection)"
show_pending   = input.bool(true, "Show Pending Zones", group=grp_pz)
pz_lookback    = input.int(7, "Pivot Lookback (Swing High/Low)", minval=3, maxval=20, group=grp_pz)
pz_forward     = input.int(25, "Forward Projection Bars", minval=5, maxval=50, group=grp_pz)
pz_max_zones   = input.int(2, "Max Zones per Side", minval=1, maxval=4, group=grp_pz)

grp_ds = "02 & 03. Dual Signal & TP/SL Target (Pips)"
show_buy_signals  = input.bool(true, "Enable BUY Signals", group=grp_ds)
show_sell_signals = input.bool(true, "Enable SELL Signals", group=grp_ds)
sl_pips  = input.int(30, "Stop Loss (Pips)", minval=5, group=grp_ds)
tp1_pips = input.int(30, "TP1 Target (Pips)", minval=5, group=grp_ds)
tp2_pips = input.int(50, "TP2 Target (Pips)", minval=5, group=grp_ds)
tp3_pips = input.int(70, "TP3 Target (Pips)", minval=5, group=grp_ds)
tp4_pips = input.int(100, "TP4 Target (Pips)", minval=5, group=grp_ds)
show_tpsl_lines   = input.bool(true, "Draw TP1-4 & SL Lines", group=grp_ds)

grp_theme = "Visual Theme (Green & Red)"
color_bull = input.color(#00C853, "Bullish Candle (Green)", group=grp_theme)
color_bear = input.color(#F23645, "Bearish Candle (Red)", group=grp_theme)
color_buy_tag = input.color(#00C853, "BUY Badge Color", group=grp_theme)
color_sell_tag = input.color(#D50000, "SELL Badge Color", group=grp_theme)

// ==========================================
// 2. ZERO REPAINT CALCULATION ENGINE
// Evaluasi hanya dilakukan saat bar selesai (barstate.isconfirmed)
// ==========================================
atr_val = ta.atr(atr_len)
ema_fast = ta.ema(close, fast_len)
ema_slow = ta.ema(close, slow_len)
rsi_val = ta.rsi(close, 14)

// Candlestick coloring like YUZARE screenshot
barcolor(close >= open ? color_bull : color_bear)

// YUZARE Trend Reaction Logic
bull_impulse = ta.crossover(ema_fast, ema_slow) or (close > close[1] + 0.4 * atr_val and ema_fast > ema_slow)
bear_impulse = ta.crossunder(ema_fast, ema_slow) or (close < close[1] - 0.4 * atr_val and ema_fast < ema_slow)

is_candle_bull = close > open and (close - open) > 0.3 * (high - low + 0.0001)
is_candle_bear = close < open and (open - close) > 0.3 * (high - low + 0.0001)

// Filter Zero Repaint: Gunakan barstate.isconfirmed
confirmed_bar = barstate.isconfirmed

buy_trigger  = confirmed_bar and bull_impulse and is_candle_bull and rsi_val >= 40 and rsi_val <= 70
sell_trigger = confirmed_bar and bear_impulse and is_candle_bear and rsi_val >= 30 and rsi_val <= 60

// Cegah sinyal berdekatan (minimal selang 3 bar)
var int last_buy_bar = -999
var int last_sell_bar = -999

buy_signal = show_buy_signals and buy_trigger and (bar_index - last_buy_bar >= 3)
sell_signal = show_sell_signals and sell_trigger and (bar_index - last_sell_bar >= 3)

if buy_signal
    last_buy_bar := bar_index

if sell_signal
    last_sell_bar := bar_index

// ==========================================
// 3. DUAL SIGNAL & TP/SL DRAWINGS
// BUY dan SELL berjalan independen tanpa saling membatalkan
// ==========================================
pip_unit = (syminfo.type == "forex" and not str.contains(syminfo.ticker, "JPY")) ? 0.0001 : (str.contains(syminfo.ticker, "XAU") or syminfo.type == "metal") ? 0.1 : (syminfo.mintick * 10)

var float active_buy_entry = na
var float active_buy_sl = na
var float active_buy_tp1 = na
var float active_buy_tp2 = na
var float active_buy_tp3 = na
var float active_buy_tp4 = na

var line buy_line_entry = na
var line buy_line_sl    = na
var line buy_line_tp1   = na
var line buy_line_tp2   = na
var line buy_line_tp3   = na
var line buy_line_tp4   = na

var line sell_line_entry = na
var line sell_line_sl    = na
var line sell_line_tp1   = na
var line sell_line_tp2   = na
var line sell_line_tp3   = na
var line sell_line_tp4   = na

var float active_sell_entry = na
var float active_sell_sl = na
var float active_sell_tp1 = na
var float active_sell_tp2 = na
var float active_sell_tp3 = na
var float active_sell_tp4 = na

// Buy Trigger Action
if buy_signal
    entry_p = close
    active_buy_entry := entry_p
    active_buy_sl    := entry_p - (sl_pips * pip_unit)
    active_buy_tp1   := entry_p + (tp1_pips * pip_unit)
    active_buy_tp2   := entry_p + (tp2_pips * pip_unit)
    active_buy_tp3   := entry_p + (tp3_pips * pip_unit)
    active_buy_tp4   := entry_p + (tp4_pips * pip_unit)
    
    // Label BUY di bawah candle (Badge Rounded mirip TradingView)
    label.new(
         bar_index, low, text="buy",
         xloc=xloc.bar_index, yloc=yloc.belowbar,
         color=color.new(#0D3A1A, 0), textcolor=#00E676,
         style=label.style_label_up, size=size.small
     )
    
    // Bersihkan garis buy sebelumnya jika ada
    line.delete(buy_line_entry)
    line.delete(buy_line_sl)
    line.delete(buy_line_tp1)
    line.delete(buy_line_tp2)
    line.delete(buy_line_tp3)
    line.delete(buy_line_tp4)

    // Gambar Garis TP/SL
    if show_tpsl_lines
        buy_line_entry := line.new(bar_index, active_buy_entry, bar_index + 12, active_buy_entry, color=color.new(color.gray, 30), style=line.style_dotted, width=1)
        buy_line_sl    := line.new(bar_index, active_buy_sl,    bar_index + 12, active_buy_sl,    color=color.new(color.red, 20),  style=line.style_dashed, width=1)
        buy_line_tp1   := line.new(bar_index, active_buy_tp1,   bar_index + 12, active_buy_tp1,   color=color.new(#00C853, 20),    style=line.style_dashed, width=1)
        buy_line_tp2   := line.new(bar_index, active_buy_tp2,   bar_index + 12, active_buy_tp2,   color=color.new(#00C853, 20),    style=line.style_dashed, width=1)
        buy_line_tp3   := line.new(bar_index, active_buy_tp3,   bar_index + 12, active_buy_tp3,   color=color.new(#00C853, 20),    style=line.style_dashed, width=1)
        buy_line_tp4   := line.new(bar_index, active_buy_tp4,   bar_index + 12, active_buy_tp4,   color=color.new(#00C853, 10),    style=line.style_solid, width=2)

// Otomatis hapus garis jika target BUY sudah terkena (Hit TP/SL)
if not na(active_buy_entry)
    if high >= active_buy_tp1 and not na(buy_line_tp1)
        line.delete(buy_line_tp1)
        buy_line_tp1 := na
    if high >= active_buy_tp2 and not na(buy_line_tp2)
        line.delete(buy_line_tp2)
        buy_line_tp2 := na
    if high >= active_buy_tp3 and not na(buy_line_tp3)
        line.delete(buy_line_tp3)
        buy_line_tp3 := na
    if high >= active_buy_tp4
        line.delete(buy_line_entry)
        line.delete(buy_line_sl)
        line.delete(buy_line_tp1)
        line.delete(buy_line_tp2)
        line.delete(buy_line_tp3)
        line.delete(buy_line_tp4)
        active_buy_entry := na
    if low <= active_buy_sl
        line.delete(buy_line_entry)
        line.delete(buy_line_sl)
        line.delete(buy_line_tp1)
        line.delete(buy_line_tp2)
        line.delete(buy_line_tp3)
        line.delete(buy_line_tp4)
        active_buy_entry := na

// Sell Trigger Action (Independen dari Buy!)
if sell_signal
    entry_p = close
    active_sell_entry := entry_p
    active_sell_sl    := entry_p + (sl_pips * pip_unit)
    active_sell_tp1   := entry_p - (tp1_pips * pip_unit)
    active_sell_tp2   := entry_p - (tp2_pips * pip_unit)
    active_sell_tp3   := entry_p - (tp3_pips * pip_unit)
    active_sell_tp4   := entry_p - (tp4_pips * pip_unit)
    
    // Label SELL di atas candle (Badge Rounded mirip TradingView)
    label.new(
         bar_index, high, text="sell",
         xloc=xloc.bar_index, yloc=yloc.abovebar,
         color=color.new(#4A151B, 0), textcolor=#FF5252,
         style=label.style_label_down, size=size.small
     )

    // Bersihkan garis sell sebelumnya jika ada
    line.delete(sell_line_entry)
    line.delete(sell_line_sl)
    line.delete(sell_line_tp1)
    line.delete(sell_line_tp2)
    line.delete(sell_line_tp3)
    line.delete(sell_line_tp4)

    // Gambar Garis TP/SL
    if show_tpsl_lines
        sell_line_entry := line.new(bar_index, active_sell_entry, bar_index + 12, active_sell_entry, color=color.new(color.gray, 30), style=line.style_dotted, width=1)
        sell_line_sl    := line.new(bar_index, active_sell_sl,    bar_index + 12, active_sell_sl,    color=color.new(color.red, 20),  style=line.style_dashed, width=1)
        sell_line_tp1   := line.new(bar_index, active_sell_tp1,   bar_index + 12, active_sell_tp1,   color=color.new(#FF1744, 20),    style=line.style_dashed, width=1)
        sell_line_tp2   := line.new(bar_index, active_sell_tp2,   bar_index + 12, active_sell_tp2,   color=color.new(#FF1744, 20),    style=line.style_dashed, width=1)
        sell_line_tp3   := line.new(bar_index, active_sell_tp3,   bar_index + 12, active_sell_tp3,   color=color.new(#FF1744, 20),    style=line.style_dashed, width=1)
        sell_line_tp4   := line.new(bar_index, active_sell_tp4,   bar_index + 12, active_sell_tp4,   color=color.new(#FF1744, 10),    style=line.style_solid, width=2)

// Otomatis hapus garis jika target SELL sudah terkena (Hit TP/SL)
if not na(active_sell_entry)
    if low <= active_sell_tp1 and not na(sell_line_tp1)
        line.delete(sell_line_tp1)
        sell_line_tp1 := na
    if low <= active_sell_tp2 and not na(sell_line_tp2)
        line.delete(sell_line_tp2)
        sell_line_tp2 := na
    if low <= active_sell_tp3 and not na(sell_line_tp3)
        line.delete(sell_line_tp3)
        sell_line_tp3 := na
    if low <= active_sell_tp4
        line.delete(sell_line_entry)
        line.delete(sell_line_sl)
        line.delete(sell_line_tp1)
        line.delete(sell_line_tp2)
        line.delete(sell_line_tp3)
        line.delete(sell_line_tp4)
        active_sell_entry := na
    if high >= active_sell_sl
        line.delete(sell_line_entry)
        line.delete(sell_line_sl)
        line.delete(sell_line_tp1)
        line.delete(sell_line_tp2)
        line.delete(sell_line_tp3)
        line.delete(sell_line_tp4)
        active_sell_entry := na

// ==========================================
// 4. PENDING ZONES (PROJECTED INTO FUTURE AREA)
// Sesuai gambar: "pending buy" & "pending sell" di masa depan sebelah kanan chart
// ==========================================
var label[] pz_labels = array.new_label()
var box[] pz_boxes = array.new_box()

// Bersihkan objek lama agar hemat memori & chart tetap bersih
if barstate.islast and show_pending
    if array.size(pz_labels) > 0
        for idx = 0 to array.size(pz_labels) - 1
            label.delete(array.get(pz_labels, idx))
        array.clear(pz_labels)
    if array.size(pz_boxes) > 0
        for idx = 0 to array.size(pz_boxes) - 1
            box.delete(array.get(pz_boxes, idx))
        array.clear(pz_boxes)

    // Cari pivot high (pending sell) dan pivot low (pending buy) terakhir
    int found_sells = 0
    int found_buys = 0

    for i = 1 to 120
        if found_sells >= pz_max_zones and found_buys >= pz_max_zones
            break
            
        ph = ta.pivothigh(high, pz_lookback, pz_lookback)[i]
        pl = ta.pivotlow(low, pz_lookback, pz_lookback)[i]

        // Pending Sell Zone (di atas harga sekarang)
        if not na(ph) and ph > close and found_sells < pz_max_zones
            found_sells += 1
            bx = box.new(
                 left=bar_index + 2 + (found_sells * 4), top=ph + 0.15 * atr_val,
                 right=bar_index + pz_forward, bottom=ph,
                 border_color=color.new(#D50000, 40),
                 bgcolor=color.new(#D50000, 85),
                 border_style=line.style_dotted
             )
            array.push(pz_boxes, bx)

            lbl = label.new(
                 x=bar_index + 10 + (found_sells * 3), y=ph,
                 text="pending sell",
                 xloc=xloc.bar_index, yloc=yloc.price,
                 color=color.new(#501015, 20), textcolor=color.new(#FF8A80, 0),
                 style=label.style_label_center, size=size.small
             )
            array.push(pz_labels, lbl)

        // Pending Buy Zone (di bawah harga sekarang)
        if not na(pl) and pl < close and found_buys < pz_max_zones
            found_buys += 1
            bx = box.new(
                 left=bar_index + 2 + (found_buys * 4), top=pl,
                 right=bar_index + pz_forward, bottom=pl - 0.15 * atr_val,
                 border_color=color.new(#00C853, 40),
                 bgcolor=color.new(#00C853, 85),
                 border_style=line.style_dotted
             )
            array.push(pz_boxes, bx)

            lbl = label.new(
                 x=bar_index + 10 + (found_buys * 3), y=pl,
                 text="pending buy",
                 xloc=xloc.bar_index, yloc=yloc.price,
                 color=color.new(#0B3C18, 20), textcolor=color.new(#B9F6CA, 0),
                 style=label.style_label_center, size=size.small
             )
            array.push(pz_labels, lbl)

// ==========================================
// 5. TRADINGVIEW ALERTS INTEGRATION
// ==========================================
alertcondition(buy_signal, title="YUZARE - BUY Signal", message="🟢 YUZARE BUY Signal confirmed on {{ticker}} at {{close}}! TP1: {{plot_0}}")
alertcondition(sell_signal, title="YUZARE - SELL Signal", message="🔴 YUZARE SELL Signal confirmed on {{ticker}} at {{close}}! TP1: {{plot_0}}")

